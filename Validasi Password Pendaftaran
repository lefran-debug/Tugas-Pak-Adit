public class ValidasiPassword {
    public static void main(String[] args) {
        String password = "abc"; // Ganti dengan password lain untuk tes

        // Operator && digunakan untuk memastikan password tidak null dan panjangnya < 6
        if (password != null && password.length() < 6) {
            System.out.println("Password terlalu pendek (minimal 6 karakter)");
        } else {
            System.out.println("Password valid");
        }
    }
}
